NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Used only by the private import tools, including fetch_range.py.
# Never expose this key in the browser, GitHub, or Vercel.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Used only by the private owner script to read exam PDFs and extract questions.
# This is an OpenAI API key (not a ChatGPT login) and must stay on your computer.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_EXTRACT_MODEL=gpt-6-sol

# Optional free local extractor. Install Ollama, then run `ollama pull qwen3-vl:8b`.
# Set this to the Google Drive folder where course folders should be saved.
GBANK_DRIVE_DIR=C:\path\to\GBank Imports
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CONTEXT_LENGTH=32768
