NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Used only by scripts/import-course.mjs. Never expose this key in the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Used only by the private owner script to read exam PDFs and extract questions.
# This is an OpenAI API key (not a ChatGPT login) and must stay on your computer.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_EXTRACT_MODEL=gpt-6-sol
